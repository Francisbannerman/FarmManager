# Copy to .env.local for development, or set these in your hosting provider's
# build settings for production. Vite bakes them into the bundle at BUILD time,
# so changing them requires a rebuild.

# Base URL of the Farm Manager API (no trailing slash, no /api/v1).
# Development falls back to http://localhost:5000 when this is unset.
# REQUIRED for production builds.
VITE_API_URL=https://api.your-domain.com

# Optional: currency label shown beside amounts (display only). Default: KES
# VITE_CURRENCY=KES
